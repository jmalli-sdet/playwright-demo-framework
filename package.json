{
  "name": "playwright-demo-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Industry-ready Playwright/TypeScript automation framework — structure mirrors a prior enterprise Android automation suite (UITestBase + RuleChain + testSteps/<area>/<Steps|P1|P2>).",
  "scripts": {
    "test": "playwright test",
    "test:p1": "playwright test --grep @P1",
    "test:p2": "playwright test --grep @P2",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium-en-US",
    "test:webkit": "playwright test --project=webkit-en-US",
    "test:mobile": "playwright test --project=mobile-chrome-pixel7",
    "test:locale:fr": "playwright test --project=chromium-fr-FR",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen https://automationexercise.com",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "test:allure": "ALLURE=1 playwright test",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report",
    "ci:merge": "playwright merge-reports --reporter html,./src/utils/reporting/DocumentationReporter.ts ./all-blob-reports",
    "ci:blob": "PLAYWRIGHT_BLOB=1 playwright test",
    "docker:test": "docker compose run --rm tests",
    "docker:report": "docker compose up report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.6.3"
  }
}
